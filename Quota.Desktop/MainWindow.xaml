<Window x:Class="Quota.Desktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:Quota.Desktop" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework" Title="Codex Quota" Icon="Assets/app.ico" Width="400" Height="464" MinWidth="360" MinHeight="280" WindowStyle="None" ResizeMode="CanResize" Background="{DynamicResource Background}" Foreground="{DynamicResource Text}" FontFamily="Segoe UI, Microsoft YaHei UI" WindowStartupLocation="CenterScreen" MouseLeftButtonDown="PanelDrag">
 <shell:WindowChrome.WindowChrome><shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="16" UseAeroCaptionButtons="False"/></shell:WindowChrome.WindowChrome>
 <Window.Resources>
  <DataTemplate x:Key="SimplifiedRingAccount">
   <Grid Height="66" Margin="0,3" ToolTip="{Binding MetricTooltip}">
    <Grid.ColumnDefinitions><ColumnDefinition Width="58"/><ColumnDefinition Width="10"/><ColumnDefinition/></Grid.ColumnDefinitions>
    <Grid Width="56" Height="56"><local:QuotaRing StrokeThickness="3" Value="{Binding FocusWindow.Value,Mode=OneWay}" Foreground="{Binding FocusWindow.Color}" Track="{DynamicResource Track}"/><TextBlock Text="{Binding FocusWindow.Percent,FallbackValue=—,TargetNullValue=—}" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid>
    <StackPanel Grid.Column="2" VerticalAlignment="Center"><TextBlock Text="{Binding Name}" FontSize="12" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding FocusWindow.CompactResetText,FallbackValue=—,TargetNullValue=—}" FontSize="13" Foreground="{DynamicResource Muted}" Margin="0,5,0,0"/></StackPanel>
   </Grid>
  </DataTemplate>
  <DataTemplate x:Key="SimplifiedBarAccount">
   <Grid Height="38" Margin="0,4" ToolTip="{Binding MetricTooltip}">
    <Grid.RowDefinitions><RowDefinition Height="24"/><RowDefinition/></Grid.RowDefinitions>
    <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <TextBlock Text="{Binding Name}" FontSize="12" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
     <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,10,0" ToolTip="{Binding FocusWindow.ResetText}"><local:AppIcon Kind="rotate-cw" Width="12" Height="12" Foreground="{DynamicResource Muted}"/><TextBlock x:Name="InlineReset" Text="{Binding FocusWindow.CompactResetText,FallbackValue=—,TargetNullValue=—}" FontSize="11" Foreground="{DynamicResource Muted}" Margin="4,0,0,0" VerticalAlignment="Center"/></StackPanel>
     <TextBlock x:Name="InlinePercent" Grid.Column="2" Text="{Binding FocusWindow.Percent,FallbackValue=—,TargetNullValue=—}" FontSize="13" VerticalAlignment="Center"/>
    </Grid>
    <ProgressBar Grid.Row="1" Value="{Binding FocusWindow.Value,Mode=OneWay}" Foreground="{Binding FocusWindow.Color}" Height="4"/>
   </Grid>
  </DataTemplate>
  <DataTemplate x:Key="CompactAccount">
   <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="16" Margin="4" Padding="10" Height="{Binding ActualWidth,RelativeSource={RelativeSource Self}}" MinHeight="176">
    <Grid><Grid.RowDefinitions><RowDefinition Height="24"/><RowDefinition Height="*"/><RowDefinition Height="20"/><RowDefinition Height="16"/></Grid.RowDefinitions>
     <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="22"/><ColumnDefinition Width="22"/></Grid.ColumnDefinitions><local:AccountName/><Button Grid.Column="1" Click="SwitchAccountClick" Tag="{Binding}" IsEnabled="{Binding CanSwitch}" Style="{StaticResource IconButton}" ToolTip="{local:Loc 切换账号}"><local:AppIcon Kind="arrow-right-left" Width="14" Height="14"/></Button><Button Grid.Column="2" Click="AccountMenu" Tag="{Binding}" Style="{StaticResource IconButton}" ToolTip="{local:Loc 账号操作}"><local:AppIcon Kind="ellipsis" Width="14" Height="14"/></Button></Grid>
     <Grid Grid.Row="1"><Grid Width="100" Height="100" HorizontalAlignment="Center" VerticalAlignment="Center"><local:QuotaRing Value="{Binding FocusWindow.Value,Mode=OneWay}" Foreground="{Binding FocusWindow.Color}" Track="{DynamicResource Track}"/><StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"><TextBlock Text="{Binding FocusWindow.Percent,TargetNullValue=—,FallbackValue=—}" HorizontalAlignment="Center" FontSize="23" FontWeight="SemiBold"/><TextBlock Text="{Binding FocusCaption}" HorizontalAlignment="Center" FontSize="9" Foreground="{DynamicResource Muted}" Margin="0,2,0,0"/></StackPanel></Grid></Grid>
     <TextBlock Grid.Row="2" Text="{Binding FocusWindow.ResetText}" FontSize="9" Foreground="{DynamicResource Muted}" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis"/>
     <Grid Grid.Row="3"><TextBlock Text="{Binding Plan}" FontSize="9" Foreground="{DynamicResource Muted}"/><Button Content="{Binding Status}" Click="AccountIssuesClick" Tag="{Binding}" Style="{StaticResource QuietButton}" Padding="0" FontSize="9" Foreground="{Binding StatusColor}" HorizontalAlignment="Right" ToolTip="{Binding ActionHint}"/></Grid>
    </Grid>
   </Border>
  </DataTemplate>
  <DataTemplate x:Key="BarAccount">
   <Border Background="{DynamicResource Surface}" CornerRadius="12" Padding="11,8" Margin="0,4" Height="72">
    <Grid><Grid.RowDefinitions><RowDefinition Height="24"/><RowDefinition Height="10"/><RowDefinition/></Grid.RowDefinitions>
     <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="22"/><ColumnDefinition Width="22"/></Grid.ColumnDefinitions><local:AccountName/><Button Grid.Column="1" Click="SwitchAccountClick" Tag="{Binding}" IsEnabled="{Binding CanSwitch}" Style="{StaticResource IconButton}" ToolTip="{local:Loc 切换账号}"><local:AppIcon Kind="arrow-right-left" Width="14" Height="14"/></Button><Button Grid.Column="2" Click="AccountMenu" Tag="{Binding}" Style="{StaticResource IconButton}" ToolTip="{local:Loc 账号操作}"><local:AppIcon Kind="ellipsis" Width="14" Height="14"/></Button></Grid><TextBlock Grid.Column="1" Text="{Binding FocusWindow.Percent,TargetNullValue=—,FallbackValue=—}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" Margin="5,0,0,0"/></Grid>
     <ProgressBar Grid.Row="1" Value="{Binding FocusWindow.Value,Mode=OneWay}" Foreground="{Binding FocusWindow.Color}" Height="4"/>
     <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding FocusWindow.ResetText}" FontSize="9" Foreground="{DynamicResource Muted}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/><Grid Grid.Column="1"><Button Content="{Binding Status}" Click="AccountIssuesClick" Tag="{Binding}" Style="{StaticResource QuietButton}" Padding="0" FontSize="9" Foreground="{Binding StatusColor}" HorizontalAlignment="Right" ToolTip="{Binding ActionHint}"/></Grid></Grid>
    </Grid>
   </Border>
  </DataTemplate>
 </Window.Resources>
 <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="16" Background="{DynamicResource Background}">
  <Grid>
  <Grid x:Name="FullLayout" Margin="10,4,10,10"><Grid.RowDefinitions><RowDefinition Height="35"/><RowDefinition Height="35"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
   <Grid Background="Transparent" MouseLeftButtonDown="TitleDrag"><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><local:BrandIcon Width="24" Height="24"/><TextBlock Text="Codex Quota" FontSize="11" FontWeight="SemiBold" Margin="7,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource Muted}"/><local:StatusLamp x:Name="RuntimeLamp" Margin="8,0,0,0" VerticalAlignment="Center"/><Button x:Name="SessionIssuesButton" AutomationProperties.Name="{local:Loc 异常会话}" Click="SessionIssuesClick" Style="{StaticResource QuietButton}" Padding="5,2" Margin="5,0,0,0" ToolTip="{local:Loc 异常会话}"><StackPanel Orientation="Horizontal"><local:AppIcon Kind="activity" Width="13" Height="13"/><TextBlock Text="{Binding CodexStatus.UnreadSessionCount,RelativeSource={RelativeSource AncestorType=local:MainWindow}}" FontSize="10" Margin="4,0,0,0" VerticalAlignment="Center"/></StackPanel></Button></StackPanel>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"><Button x:Name="PinButton" Click="TogglePin" Style="{StaticResource IconButton}" Width="29" Height="29" ToolTip="{local:Loc 切换置顶}"><local:AppIcon Kind="pin"/></Button><Button x:Name="SettingsButton" Click="SettingsClick" Style="{StaticResource IconButton}" Width="29" Height="29" ToolTip="{local:Loc 设置}"><local:AppIcon Kind="settings-2"/></Button><Button  Click="MinimizeWindow" Style="{StaticResource IconButton}" Width="29" Height="29" ToolTip="{local:Loc 收起到托盘}"><local:AppIcon Kind="minus"/></Button><Button  Click="CloseWindow" Style="{StaticResource IconButton}" Width="29" Height="29" ToolTip="{local:Loc 关闭窗口}"><local:AppIcon Kind="x"/></Button></StackPanel>
   </Grid>
   <Grid Grid.Row="1" Margin="5,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <Button Click="SummaryIssuesClick" Style="{StaticResource QuietButton}" HorizontalAlignment="Left" Padding="0" ToolTip="{local:Loc 查看处理详情}"><TextBlock x:Name="Summary" Text="{local:Loc 正在准备}" Foreground="{DynamicResource Muted}" FontSize="10"/></Button>
    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Border x:Name="DemoBadge" Visibility="Collapsed" CornerRadius="4" Padding="5,3" Margin="0,0,4,0" Background="{DynamicResource ButtonFill}"><TextBlock Text="{local:Loc 演示}" FontSize="9" Foreground="{DynamicResource Muted}"/></Border><Button x:Name="SimplifiedModeButton" Click="SimplifiedModeClick" Style="{StaticResource IconButton}" Width="29" Height="29" ToolTip="{local:Loc 精简模式}" AutomationProperties.Name="{local:Loc 精简模式}"><local:AppIcon Kind="minimize-2"/></Button><Button x:Name="RefreshButton" Click="RefreshClick" Style="{StaticResource IconButton}" Width="29" Height="29" ToolTip="{local:Loc 刷新额度}"><local:AppIcon Kind="refresh-cw"/></Button><Button  Click="AddMenuClick" Style="{StaticResource IconButton}" Width="29" Height="29" ToolTip="{local:Loc 添加或导入账号}"><local:AppIcon Kind="plus"/></Button></StackPanel>
   </Grid>
   <Border Grid.Row="2" x:Name="NoticeBorder" Background="{DynamicResource ButtonFill}" CornerRadius="8" Margin="4,0,4,6" Padding="9" Visibility="Collapsed"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="24"/></Grid.ColumnDefinitions><TextBlock x:Name="Notice" TextWrapping="Wrap" FontSize="10"/><Button Grid.Column="1" Style="{StaticResource IconButton}" Click="DismissNotice" ToolTip="{local:Loc 收起提示}"><local:AppIcon Kind="x" Width="13" Height="13"/></Button></Grid></Border>
   <Grid Grid.Row="3">
    <ScrollViewer x:Name="CompactPanel" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" CanContentScroll="False"><ItemsControl x:Name="AccountList" ItemTemplate="{StaticResource CompactAccount}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2"/></ItemsPanelTemplate></ItemsControl.ItemsPanel></ItemsControl></ScrollViewer>
    <Grid x:Name="NormalPanel" Visibility="Collapsed" Margin="3,0"><Grid.ColumnDefinitions><ColumnDefinition Width="170"/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions>
     <ScrollViewer VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled"><ContentControl x:Name="FocusAccount" VerticalAlignment="Top" Height="{Binding ActualHeight,ElementName=OtherAccountList}" MaxHeight="{Binding ViewportHeight,ElementName=OtherAccountsScroll}" MinHeight="216"><ContentControl.ContentTemplate><DataTemplate><Border Background="{DynamicResource Surface}" CornerRadius="14" Padding="12" Margin="0,4"><StackPanel VerticalAlignment="Center"><local:AccountName/><Grid Margin="0,7"><Grid Width="120" Height="120" HorizontalAlignment="Center" VerticalAlignment="Center"><local:QuotaRing Value="{Binding FocusWindow.Value,Mode=OneWay}" Foreground="{Binding FocusWindow.Color}" Track="{DynamicResource Track}"/><StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"><TextBlock Text="{Binding FocusWindow.Percent,TargetNullValue=—,FallbackValue=—}" HorizontalAlignment="Center" FontSize="28" FontWeight="SemiBold"/><TextBlock Text="{Binding FocusCaption}" HorizontalAlignment="Center" FontSize="9" Foreground="{DynamicResource Muted}" Margin="0,2,0,0"/></StackPanel></Grid></Grid><TextBlock Text="{Binding FocusWindow.ResetText}" HorizontalAlignment="Center" FontSize="9" Foreground="{DynamicResource Muted}"/><TextBlock Text="{Binding Plan}" HorizontalAlignment="Center" FontSize="9" Foreground="{DynamicResource Muted}" Margin="0,6,0,0"/></StackPanel></Border></DataTemplate></ContentControl.ContentTemplate></ContentControl></ScrollViewer>
     <ScrollViewer x:Name="OtherAccountsScroll" Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" CanContentScroll="False"><ItemsControl x:Name="OtherAccountList" VerticalAlignment="Top" ItemTemplate="{StaticResource BarAccount}"/></ScrollViewer>
    </Grid>
   </Grid>
  </Grid>
  <ScrollViewer x:Name="SimplifiedPanel" Visibility="Collapsed" Margin="12,8" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" ToolTip="{local:Loc 双击返回完整界面}" ContextMenuOpening="SimplifiedMenuOpening" PreviewMouseLeftButtonDown="SimplifiedPointerDown"><ItemsControl x:Name="SimplifiedAccounts"/></ScrollViewer>
  </Grid>
 </Border>
</Window>
