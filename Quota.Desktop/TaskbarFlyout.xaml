<Window x:Class="Quota.Desktop.TaskbarFlyout" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:Quota.Desktop" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework" Title="Codex Quota Accounts" Width="332" SizeToContent="Height" WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False" ShowActivated="False" Topmost="True" Background="{DynamicResource Background}" Foreground="{DynamicResource Text}" FontFamily="Segoe UI, Microsoft YaHei UI">
 <shell:WindowChrome.WindowChrome><shell:WindowChrome CaptionHeight="0" GlassFrameThickness="0" CornerRadius="16" ResizeBorderThickness="0"/></shell:WindowChrome.WindowChrome>
 <Window.Resources>
  <DataTemplate x:Key="TaskbarAccount">
   <Border Background="{DynamicResource Surface}" CornerRadius="12" Margin="3" Padding="9" Height="130">
    <Grid><Grid.RowDefinitions><RowDefinition Height="21"/><RowDefinition Height="*"/><RowDefinition Height="16"/><RowDefinition Height="13"/></Grid.RowDefinitions>
     <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="23"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Name}" FontSize="10" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding MetricTooltip}" VerticalAlignment="Center"/><Button Grid.Column="1" Tag="{Binding}" Click="SwitchAccount" Style="{StaticResource IconButton}" ToolTip="{local:Loc 切换账号}"><local:AppIcon Kind="arrow-right-left" Width="13" Height="13"/></Button></Grid>
     <Button Grid.Row="1" Tag="{Binding}" Click="SelectAccount" Style="{StaticResource QuietButton}" Padding="0"><Grid Width="65" Height="65"><local:QuotaRing Value="{Binding FocusWindow.Value,Mode=OneWay}" Foreground="{Binding FocusWindow.Color}" Track="{DynamicResource Track}"/><StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"><TextBlock Text="{Binding FocusWindow.Percent,FallbackValue=—,TargetNullValue=—}" FontSize="17" FontWeight="SemiBold" Foreground="{Binding FocusWindow.Color}" HorizontalAlignment="Center"/><TextBlock Text="{Binding FocusWindow.Label}" FontSize="8" Foreground="{DynamicResource Muted}" HorizontalAlignment="Center"/></StackPanel></Grid></Button>
     <TextBlock Grid.Row="2" Text="{Binding FocusWindow.ResetText,FallbackValue=—}" FontSize="8" Foreground="{DynamicResource Muted}" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis"/>
     <Button Grid.Row="3" Tag="{Binding}" Click="ShowIssue" Style="{StaticResource QuietButton}" Padding="0" HorizontalAlignment="Center"><TextBlock Text="{Binding Status}" FontSize="8" Foreground="{Binding StatusColor}"/></Button>
    </Grid>
   </Border>
  </DataTemplate>
 </Window.Resources>
   <Border x:Name="FlyoutBody" Width="332" Background="{DynamicResource Background}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="16" Padding="9" MouseEnter="FlyoutEnter" MouseLeave="LeaveArea">
    <DockPanel><Grid DockPanel.Dock="Top" Height="30" Margin="3,0,3,5"><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><local:BrandIcon Width="21" Height="21"/><TextBlock Text="Codex Quota" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" Margin="6,0"/><local:StatusLamp Width="7" Height="7" VerticalAlignment="Center" Status="{Binding CodexStatus,RelativeSource={RelativeSource AncestorType=local:TaskbarFlyout}}"/></StackPanel><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Click="OpenSessionIssues" Style="{StaticResource IconButton}" ToolTip="{local:Loc 异常会话}"><local:AppIcon Kind="activity" Width="14" Height="14"/></Button><Button Click="RefreshAccounts" Style="{StaticResource IconButton}" ToolTip="{local:Loc 刷新额度}"><local:AppIcon Kind="refresh-cw" Width="14" Height="14"/></Button><Button Click="OpenSettings" Style="{StaticResource IconButton}" ToolTip="{local:Loc 设置}"><local:AppIcon Kind="settings-2" Width="14" Height="14"/></Button><Button Click="OpenMain" Style="{StaticResource IconButton}" ToolTip="{local:Loc 打开额度监控}"><local:AppIcon Kind="monitor" Width="14" Height="14"/></Button><Button Click="ClosePanel" Style="{StaticResource IconButton}" ToolTip="{local:Loc 关闭}"><local:AppIcon Kind="x" Width="14" Height="14"/></Button></StackPanel></Grid>
     <Border DockPanel.Dock="Top" Background="{DynamicResource ButtonFill}" CornerRadius="8" Padding="9" Margin="3,0,3,6" Visibility="{Binding CodexStatus.NeedsInput,RelativeSource={RelativeSource AncestorType=local:TaskbarFlyout},Converter={StaticResource Visible}}"><TextBlock Text="{Binding CodexStatus.InputMessage,RelativeSource={RelativeSource AncestorType=local:TaskbarFlyout}}" TextWrapping="Wrap" FontSize="11"/></Border><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" MaxHeight="408"><ItemsControl x:Name="AccountCards" ItemTemplate="{StaticResource TaskbarAccount}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2"/></ItemsPanelTemplate></ItemsControl.ItemsPanel></ItemsControl></ScrollViewer>
    </DockPanel>
   </Border>
</Window>